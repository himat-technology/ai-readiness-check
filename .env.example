# AI Readiness Check — Environment Variables
# Copy to .env.local and adjust as needed.
# No API keys are required for basic local analysis.

# Optional: override default fetch timeout (ms)
ANALYZE_TIMEOUT_MS=15000

# Optional: custom User-Agent for outbound fetches
# ANALYZE_USER_AGENT=AIReadinessCheck/1.0 (+https://yourdomain.com)

# Optional: public app URL (useful for SaaS deployment / absolute links)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
